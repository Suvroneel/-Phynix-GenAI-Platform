# ==========================================
# PHYNIX DJANGO ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your actual secrets
# DO NOT commit .env to version control!

# ==========================================
# DJANGO SETTINGS
# ==========================================
SECRET_KEY=django-insecure-CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-IN-PRODUCTION
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
# Replace with your actual PostgreSQL credentials
DB_NAME=phynix_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# SUPABASE CREDENTIALS (from Streamlit secrets)
# ==========================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ==========================================
# HUGGING FACE API
# ==========================================
# Get token from: https://huggingface.co/settings/tokens
# Optional but recommended for better rate limits
HUGGINGFACE_TOKEN=hf_your_huggingface_token_here

# ==========================================
# REDIS (for WebSockets - Optional)
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
# For password reset emails, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# ==========================================
# CORS SETTINGS (for frontend)
# ==========================================
# Add your frontend URL here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ==========================================
# SECURITY SETTINGS (Production only)
# ==========================================
# Set these when deploying to production
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
